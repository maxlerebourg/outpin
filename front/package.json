{
  "name": "outpin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --port=5173",
    "build": "vite build",
    "serve": "vite preview --port=5173",
    "intl": "npx --yes tsx ./script/translate.ts --default-lang=en",
    "intl:check": "npm run intl && npx --yes tsx ./script/checkTranslate.ts --origin-lang=en",
    "lint": "npx --yes @biomejs/biome format .",
    "lint:fix": "npx --yes @biomejs/biome format --write ."
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "daisyui": "^5.6.13",
    "dompurify": "^3.4.11",
    "marked": "^18.0.5",
    "pocketbase": "^0.27.0",
    "svelte": "^5.56.4",
    "svelte-maplibre": "^1.3.0",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.3",
    "zod": "^4.4.3"
  }
